# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kania_workforce

# Server
PORT=3000
NODE_ENV=development

# Claude API (für KI-Agenten später)
ANTHROPIC_API_KEY=your_api_key_here

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@kania-galabau.de

# Twilio (für WhatsApp/SMS später)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+49xyz

# Admin Password
ADMIN_PASSWORD=change_me_in_production
